#!/usr/bin/env bash

set -u

show_help() {
    cat <<'HELP'
PowerDash

Usage:
  powerdash [OPTION]

Options:
  --compact    Show the compact dashboard
  --full       Show the detailed dashboard
  -h, --help   Show this help message

Examples:
  powerdash
  powerdash --compact
  powerdash --full
  watch -n 5 powerdash

PowerDash estimates wall power using CPU package power, GPU power,
a configurable platform load, and an estimated PSU efficiency.

This is a software estimate, not a physical wall meter reading.
HELP
}

MODE="auto"

if (( $# > 1 )); then
    printf 'powerdash: expected at most one option. Try --help.\n' >&2
    exit 2
fi

case "${1:-}" in
    "")
        ;;
    --compact)
        MODE="compact"
        ;;
    --full)
        MODE="full"
        ;;
    -h|--help)
        show_help
        exit 0
        ;;
    *)
        printf 'powerdash: unknown option: %s\n' "$1" >&2
        printf 'Try powerdash --help.\n' >&2
        exit 2
        ;;
esac

CONFIG="/etc/powerdash.conf"
[[ -r "$CONFIG" ]] && source "$CONFIG"

RATE="${RATE:-0.15}"
CURRENCY_SYMBOL="${CURRENCY_SYMBOL:-\$}"
DATA_DIR="${DATA_DIR:-/var/lib/powerdash}"
RUNTIME_DIR="${RUNTIME_DIR:-/run/powerdash}"

LOG_FILE="${DATA_DIR}/power.log"
TREND_FILE="${DATA_DIR}/trend.log"
CURRENT_FILE="${RUNTIME_DIR}/current.env"

HOST_NAME="$(
    hostname -s 2>/dev/null ||
        hostname 2>/dev/null ||
        printf 'unknown'
)"

TERM_LINES="$(tput lines 2>/dev/null || echo 24)"
TERM_COLS="$(tput cols 2>/dev/null || echo 80)"

if read -r TTY_LINES TTY_COLS < <(
    stty size </dev/tty 2>/dev/null
); then
    [[ "$TTY_LINES" =~ ^[0-9]+$ ]] && TERM_LINES="$TTY_LINES"
    [[ "$TTY_COLS" =~ ^[0-9]+$ ]] && TERM_COLS="$TTY_COLS"
fi

if [[ "$MODE" == "auto" ]]; then
    if (( TERM_LINES <= 22 )); then
        MODE="compact"
    else
        MODE="full"
    fi
fi

SERVICE_STATE="$(
    systemctl is-active power-estimator.service 2>/dev/null || true
)"

[[ -z "$SERVICE_STATE" ]] && SERVICE_STATE="unknown"

TIMER_STATE="$(
    systemctl is-active power-trend.timer 2>/dev/null || true
)"

[[ -z "$TIMER_STATE" ]] && TIMER_STATE="unknown"

NEXT_TREND="$(
    systemctl show power-trend.timer \
        -p NextElapseUSecRealtime \
        --value 2>/dev/null || true
)"

if [[ -n "$NEXT_TREND" && "$NEXT_TREND" != "n/a" ]]; then
    NEXT_TREND_SHORT="$(
        date -d "$NEXT_TREND" '+%H:%M' 2>/dev/null || echo "?"
    )"
else
    NEXT_TREND_SHORT="?"
fi

if [[ -r "$CURRENT_FILE" ]]; then
    source "$CURRENT_FILE"
else
    TIMESTAMP="no live sample"
    CPU_W="0"
    GPU_W="0"
    FIXED_LOAD_W="${FIXED_LOAD_W:-35}"
    INTERNAL_W="0"
    PSU_EFF="0"
    WALL_W="0"
    AVG_WALL="0"
    AVG_WINDOW="0"
fi

UPDATED_TIME="${TIMESTAMP##* }"

if [[ -s "$LOG_FILE" ]]; then
    STATS="$(
        awk '
        $NF ~ /^[0-9]+([.][0-9]+)?$/ {
            w = $NF + 0

            if (n == 0) {
                min = max = w
                first = $1 " " $2
            }

            total += w
            n++

            if (w < min) min = w
            if (w > max) max = w

            last = $1 " " $2
        }

        END {
            if (n) {
                printf "%.4f|%.4f|%.4f|%d|%s|%s\n",
                    total/n,
                    min,
                    max,
                    n,
                    first,
                    last
            } else {
                print "0|0|0|0||"
            }
        }' "$LOG_FILE"
    )"
else
    STATS="0|0|0|0||"
fi

IFS='|' read -r \
    LONG_AVG \
    MIN_W \
    MAX_W \
    SAMPLES \
    FIRST_TS \
    LAST_TS <<< "$STATS"

convert_ts() {
    sed -E \
        's#^([0-9]{2})/([0-9]{2})/([0-9]{4}) #\3-\2-\1 #' \
        <<< "$1"
}

LOG_SECONDS=0

if [[ -n "$FIRST_TS" && -n "$LAST_TS" ]]; then
    FIRST_EPOCH="$(
        date -d "$(convert_ts "$FIRST_TS")" +%s 2>/dev/null || true
    )"

    LAST_EPOCH="$(
        date -d "$(convert_ts "$LAST_TS")" +%s 2>/dev/null || true
    )"

    if [[ -n "$FIRST_EPOCH" && -n "$LAST_EPOCH" ]]; then
        LOG_SECONDS=$((LAST_EPOCH - FIRST_EPOCH))

        (( LOG_SECONDS < 0 )) && LOG_SECONDS=0
    fi
fi

LOG_MINUTES="$(
    awk -v s="$LOG_SECONDS" \
        'BEGIN { printf "%.1f", s/60 }'
)"

LOG_HOURS="$(
    awk -v s="$LOG_SECONDS" \
        'BEGIN { printf "%.1f", s/3600 }'
)"

LOG_DAYS="$(
    awk -v s="$LOG_SECONDS" \
        'BEGIN { printf "%.1f", s/86400 }'
)"

if (( LOG_SECONDS < 3600 )); then
    SPAN="${LOG_MINUTES} min"
    MATURITY="warming up"
elif (( LOG_SECONDS < 86400 )); then
    SPAN="${LOG_HOURS} h"
    MATURITY="short sample"
elif (( LOG_SECONDS < 604800 )); then
    SPAN="${LOG_DAYS} d"
    MATURITY="building baseline"
else
    SPAN="${LOG_DAYS} d"
    MATURITY="good baseline"
fi

read -r \
    DAILY_KWH \
    DAILY_COST \
    MONTHLY_KWH \
    MONTHLY_COST \
    YEARLY_KWH \
    YEARLY_COST < <(

    awk \
        -v w="$LONG_AVG" \
        -v rate="$RATE" '
    BEGIN {
        daily = w * 24 / 1000
        monthly = w * 730 / 1000
        yearly = w * 8760 / 1000

        printf "%.2f %.2f %.2f %.2f %.2f %.2f\n",
            daily,
            daily * rate,
            monthly,
            monthly * rate,
            yearly,
            yearly * rate
    }'
)

if [[ -s "$TREND_FILE" ]]; then
    LAST_TREND="$(tail -n 1 "$TREND_FILE")"

    TREND_TS="$(
        echo "$LAST_TREND" |
            cut -d'|' -f1 |
            sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
    )"

    TREND_COST="$(
        echo "$LAST_TREND" |
            cut -d'|' -f4 |
            sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
    )"

    TREND_TIME="${TREND_TS##* }"
else
    LAST_TREND="none yet"
    TREND_COST="none"
    TREND_TIME="-"
fi

power_bar() {
    local value="${1:-0}"
    local width="${2:-20}"
    local max_watts=300

    local filled
    local empty
    local i

    filled="$(
        awk \
            -v value="$value" \
            -v max="$max_watts" \
            -v width="$width" '
        BEGIN {
            n = int((value/max)*width + 0.5)

            if (n < 0)
                n = 0

            if (n > width)
                n = width

            print n
        }'
    )"

    empty=$((width - filled))

    printf '['

    for ((i=0; i<filled; i++)); do
        printf '#'
    done

    for ((i=0; i<empty; i++)); do
        printf '-'
    done

    printf ']'
}

if [[ "$MODE" == "compact" ]]; then
    printf 'POWERDASH - %s                       %s\n' \
        "$HOST_NAME" \
        "$UPDATED_TIME"

    printf 'Collector:%s  Trend:%s  Next:%s\n' \
        "$SERVICE_STATE" \
        "$TIMER_STATE" \
        "$NEXT_TREND_SHORT"

    printf '\nLIVE\n'

    printf 'CPU %.1fW | GPU %.1fW | Platform %.0fW | Internal %.1fW\n' \
        "$CPU_W" \
        "$GPU_W" \
        "$FIXED_LOAD_W" \
        "$INTERNAL_W"

    printf 'Wall %.1fW ' "$WALL_W"
    power_bar "$WALL_W" 18
    printf '  Rolling %.1fW\n' "$AVG_WALL"

    printf '\nBASELINE\n'

    printf '%s | %s samples | %s\n' \
        "$SPAN" \
        "$SAMPLES" \
        "$MATURITY"

    printf 'Avg %.1fW | Min %.1fW | Max %.1fW\n' \
        "$LONG_AVG" \
        "$MIN_W" \
        "$MAX_W"

    printf '\nCOST @ %s %.3f/kWh\n' \
        "$CURRENCY_SYMBOL" \
        "$RATE"

    printf 'Day     %6.2f kWh   %s %7.2f\n' \
        "$DAILY_KWH" \
        "$CURRENCY_SYMBOL" \
        "$DAILY_COST"

    printf 'Month   %6.2f kWh   %s %7.2f\n' \
        "$MONTHLY_KWH" \
        "$CURRENCY_SYMBOL" \
        "$MONTHLY_COST"

    printf 'Year   %7.2f kWh   %s %7.2f\n' \
        "$YEARLY_KWH" \
        "$CURRENCY_SYMBOL" \
        "$YEARLY_COST"

    if [[ "$TREND_COST" == "none" ]]; then
        printf '\nTrend: none yet | next %s\n' \
            "$NEXT_TREND_SHORT"
    else
        printf '\nTrend: %s @ %s | next %s\n' \
            "$TREND_COST" \
            "$TREND_TIME" \
            "$NEXT_TREND_SHORT"
    fi

    exit 0
fi

printf 'POWERDASH - %s\n' "$HOST_NAME"
printf '%*s\n' 72 '' | tr ' ' '='
printf '\n'

printf 'Collector: %-8s   Trend: %-8s   Updated: %s\n' \
    "$SERVICE_STATE" \
    "$TIMER_STATE" \
    "$TIMESTAMP"

printf 'Next trend: %s\n' "$NEXT_TREND_SHORT"

printf '\nLIVE POWER\n'
printf '%*s\n' 72 '' | tr ' ' '-'

printf '  CPU package        %9.2f W\n' \
    "$CPU_W"

printf '  GPU                %9.2f W\n' \
    "$GPU_W"

printf '  Platform estimate  %9.2f W\n' \
    "$FIXED_LOAD_W"

printf '  Internal DC        %9.2f W\n' \
    "$INTERNAL_W"

printf '  PSU efficiency     %9.1f %%\n' \
    "$(awk -v e="$PSU_EFF" 'BEGIN {printf "%.1f", e*100}')"

printf '  Estimated wall     %9.2f W  ' \
    "$WALL_W"

power_bar "$WALL_W" 28
printf '\n'

printf '  Rolling average    %9.2f W  (%s samples)\n' \
    "$AVG_WALL" \
    "$AVG_WINDOW"

printf '\nMEASUREMENT BASELINE\n'
printf '%*s\n' 72 '' | tr ' ' '-'

printf '  Observation span   %9s\n' \
    "$SPAN"

printf '  Status             %9s\n' \
    "$MATURITY"

printf '  Samples            %9s\n' \
    "$SAMPLES"

printf '  Long-term average  %9.2f W\n' \
    "$LONG_AVG"

printf '  Minimum            %9.2f W\n' \
    "$MIN_W"

printf '  Maximum            %9.2f W\n' \
    "$MAX_W"

printf '\nCOST PROJECTION @ %s %.3f/kWh\n' \
    "$CURRENCY_SYMBOL" \
    "$RATE"

printf '%*s\n' 72 '' | tr ' ' '-'

printf '  Daily              %9.2f kWh    %s %8.2f\n' \
    "$DAILY_KWH" \
    "$CURRENCY_SYMBOL" \
    "$DAILY_COST"

printf '  Monthly (730 h)    %9.2f kWh    %s %8.2f\n' \
    "$MONTHLY_KWH" \
    "$CURRENCY_SYMBOL" \
    "$MONTHLY_COST"

printf '  Yearly (8760 h)    %9.2f kWh    %s %8.2f\n' \
    "$YEARLY_KWH" \
    "$CURRENCY_SYMBOL" \
    "$YEARLY_COST"

printf '\nTREND\n'
printf '%*s\n' 72 '' | tr ' ' '-'

printf '  Last snapshot: %s\n' \
    "$LAST_TREND"

printf '\n'

printf 'Model: CPU + GPU + %.0f W platform + modeled PSU efficiency.\n' \
    "$FIXED_LOAD_W"

printf 'Software estimate, not a physical wall meter measurement.\n'
